{
  "name": "linepulse-iiot",
  "version": "1.0.0",
  "private": true,
  "description": "Software-simulated IIoT fault propagation and production-loss analysis",
  "workspaces": ["client", "server"],
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --workspace server run dev",
    "dev:client": "npm --workspace client run dev",
    "build": "npm --workspace client run build",
    "test": "npm --workspace server test",
    "seed": "npm --workspace server run seed",
    "lint": "npm --workspace server run lint && npm --workspace client run lint"
  },
  "devDependencies": { "concurrently": "^9.1.2" },
  "engines": { "node": ">=20.0.0" }
}